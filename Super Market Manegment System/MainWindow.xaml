<Window x:Class="Super_Market_Manegment_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cashier Panel"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen" >


    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="486*"/>
            <RowDefinition Height="220*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Cashier Dashboard"
                   Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="8,2,8,12"/>



        <!--left side-->

        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource CardBorderStyle}" Margin="6,6,6,6" Grid.RowSpan="2"
                   BorderThickness="2"
                   Background=" #E8EAF0">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="47*"/>
                    <RowDefinition Height="233*"/>
                    <RowDefinition Height="306*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Pending Orders header -->
                <TextBlock Text="Pending Orders"
                           Grid.Row="0"
                           Grid.Column="0"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="5,5,5,5"/>

                <!-- Available Products header -->
                <TextBlock Text="Available Products"
                           Grid.Row="0"
                           Grid.Column="1"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="180,5,0,5"
                           HorizontalAlignment="Left"/>

                <!-- Pending Orders grid -->
                <DataGrid x:Name="OrderGrid"
                          Grid.Row="1"
                          Grid.Column="0"
                          Margin="5,5,5,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          FontSize="13"
                          VerticalAlignment="Top"
                          MinHeight="420" Grid.RowSpan="3">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order ID" Binding="{Binding OrderID}" Width="*"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Product ID" Binding="{Binding ProductID}" Width="*"/>
                        <DataGridTextColumn Header="Order Detail ID" Binding="{Binding OrderDetailID}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Products grid -->
                <DataGrid x:Name="ProductGrid"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="5,5,0,0"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          FontSize="12"
                          VerticalAlignment="Top"
                          MinHeight="320" Grid.RowSpan="3" Height="427">
                </DataGrid>

                <!-- Buttons row -->
                <StackPanel Grid.Row="4"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="5,5,0,5">
                    <Button Content="Add  To Cart"
                            Width="140"
                            Height="35"
                            Margin="0,0,10,0"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="btnAddFromOrder_Click"/>
                    
                    
                </StackPanel>

                <StackPanel Grid.Row="4"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="185,5,0,5">
                    <Button Content="Add To Cart"
                            Width="160"
                            Height="35"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="btnAddToCart_Click"/>
                </StackPanel>
            </Grid>
        </Border>


        <!--right side-->

        <Border Grid.Row="1"
                Grid.Column="1"
                 Background=" #E8EAF0"
                Style="{StaticResource CardBorderStyle}" Margin="6,6,6,6" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="356*"/>
                    <RowDefinition Height="151*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Shoping Cart"
                           Grid.Row="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="5,5,5,5"/>

                <ListBox x:Name="CartList"
                         Grid.Row="1"
                         Margin="5,5,5,5" Grid.RowSpan="2"/>

                <TextBlock Text="Total Amount"
                           Grid.Row="3"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="5,5,5,5"/>

                <TextBox x:Name="txtTotal"
                         Grid.Row="4"
                         Height="35"
                         Margin="5,5,5,5"
                         IsReadOnly="True"
                         FontSize="16"/>

                <Button Content="PAY"
                        Grid.Row="5"
                        Height="45"
                        Margin="5,5,5,5"
                        Background="{StaticResource WarningBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnPay_Click"/>




            </Grid>


        </Border>

    </Grid>
    
</Window>

