<Window x:Class="Super_Market_Manegment_System.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Super_Market_Manegment_System"
        mc:Ignorable="d"
        Title="Login"
        Height="420"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid  Background=" #E8EAF0">
        <Border Style="{StaticResource CardBorderStyle}"
                BorderBrush="white"
                BorderThickness="2"
                 Background=" #E8EAF0"
                Width="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Super Market Login"
                           Grid.Row="0"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="5,4,5,2"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Sign in to continue"
                           Grid.Row="1"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="5,0,5,10"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Username"
                           Grid.Row="2"
                           Margin="5,8,5,2"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="txtusername"
                         Grid.Row="3"/>

                <TextBlock Text="Password"
                           Grid.Row="4"
                           Margin="5,8,5,2"
                           FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtpassword"
                             Grid.Row="5"/>

                <Button Content="Login"
                        Grid.Row="6"
                        Margin="5,16,5,2"
                        Background="{StaticResource PrimaryBrush}"
                        Click="btnLogin_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
