<Window x:Class="Super_Market_Manegment_System.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Page"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="83*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Customer Ordering"
                   Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="8,2,8,12"/>



        <!--products-->

        <Border Grid.Row="1"
               Grid.Column="0"
               Background=" #E8EAF0"
               Style="{StaticResource CardBorderStyle}" 
                Height="603" Margin="10,2,1,0" 
                VerticalAlignment="Top" Grid.RowSpan="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Available Products"
                           Grid.Row="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="5"/>

                <DataGrid x:Name="ProductGrid"
                          Grid.Row="1"
                          Margin="5"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          FontSize="12"
                          VerticalAlignment="Top"
                          MaxHeight="290">
                </DataGrid>

                <Button Content="Add To Cart"
                        Grid.Row="2"
                        Width="350"
                        Height="40"
                        Margin="5"
                        Background="{StaticResource SuccessBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnAddToCart_Click"/>


            </Grid>

        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                 Background=" #E8EAF0"
                Style="{StaticResource CardBorderStyle}" Margin="6,6,6,6" Grid.RowSpan="2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17*"/>
                    <ColumnDefinition Width="144*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="97*"/>
                    <RowDefinition Height="316*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="My Cart"
                           Grid.Row="0"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="5,5,5,5" Grid.ColumnSpan="2" />
                <ListBox x:Name="CartList"
                         Grid.Row="1"
                         Margin="5,5,5,5" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
                <TextBlock Text="Total"
                           Grid.Row="3"
                           FontWeight="Bold"
                           Margin="5,5,5,5" Grid.ColumnSpan="2" />
                <TextBox x:Name="txtTotal"
                         Grid.Row="4"
                         Height="35"
                         Margin="5,5,5,5"
                         IsReadOnly="True" Grid.ColumnSpan="2"/>
                <Button Content="Place Order"
                        Grid.Row="5"
                        Height="45"
                        Margin="5,5,5,5"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnOrder_Click" Grid.ColumnSpan="2"/>



            </Grid>

        </Border>

    </Grid>
</Window>