<Window x:Class="Super_Market_Manegment_System.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel"
        Height="800"
        Width="1050"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Admin Product Management"
                   Grid.Row="0"
                   Grid.ColumnSpan="2"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="8,2,8,12"/>

        

        <!--input section-->
        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource CardBorderStyle}"
                Background="#E8EAF0"
                Margin="10,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!--product name-->

                <TextBlock Text="Product Name :" 
                     Grid.Row="0"
                     Grid.Column="0"
                     Margin="5"
                     FontSize="14"
                     FontWeight="SemiBold"/>
                <TextBox x:Name="txtName"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="5"
                     Height="34"
                     FontSize="14"/>

                <!--catecory id-->
                <TextBlock Text="Category ID :"
                       Grid.Row="1"
                       Grid.Column="0"
                       Margin="5"
                       FontSize="14"
                       FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbCategory"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="5"
                     Height="34"
                     FontSize="14"/>
                <!--Price-->
                <TextBlock Text="Price:"
                       Grid.Row="2"
                       Grid.Column="0"
                       Margin="5"
                       FontSize="14"
                       FontWeight="SemiBold"/>
                <TextBox x:Name="txtPrice"
                     Grid.Row="2"
                     Grid.Column="1"
                     Margin="5"
                     Height="34"
                     FontSize="14"/>
                <!--Quantity-->

                <TextBlock Text="Quantity :"
                      Grid.Row="3"
                      Grid.Column="0"
                      Margin="5"
                      FontSize="14"
                      FontWeight="SemiBold"/>
                <TextBox x:Name="txtQuantity"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="5"
                     Height="34"
                     FontSize="14"/>

                <!--buttons-->
                <StackPanel Orientation="Horizontal"
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    Margin="10">

                    <Button Content="Add"
                        Width="110"
                        Height="36"
                        Margin="5"
                        Background="{StaticResource SuccessBrush}"
                        FontWeight="Bold"
                        Click="btnAdd_Click"/>

                    <Button Content="Update "
                        Width="120"
                        Height="36"
                        Margin="5"
                        Background="{StaticResource PrimaryBrush}"
                        FontWeight="Bold"
                        Click="btnUpdate_Click"/>

                    <Button Content="Delete" 
                        Width="120"
                        Height="36"
                        Margin="5"
                        Background="{StaticResource DangerBrush}"
                        FontWeight="Bold"
                        Click="btnDelete_Click"/>

                </StackPanel>



            </Grid>
        </Border>

        <Border  Background="#E8EAF0"
                Style="{StaticResource CardBorderStyle}"
                Margin="71,42,18,19" 
                Grid.RowSpan="2" Grid.Column="1">
            <DataGrid x:Name="ProductGrid"
                      Margin="0"
                      AutoGenerateColumns="True"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      FontSize="13"
                      VerticalAlignment="Top"
                      MaxHeight="560"
                      SelectionChanged="onChanged"/>
        </Border>




    </Grid>
</Window>

    